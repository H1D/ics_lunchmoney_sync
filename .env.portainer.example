# Telegram Bot Configuration
TOKEN=your_telegram_bot_token_here
USER_ID=your_telegram_user_id_here

# ICS Bank Credentials
ICS_EMAIL=your_ics_email@example.com
ICS_PASSWORD=your_ics_password_here

# Lunch Money Configuration
LUNCHMONEY_TOKEN=your_lunchmoney_api_token_here
LUNCHMONEY_ASSET_ID=your_asset_id_here

# Sync Configuration
SYNC_DAYS=30

